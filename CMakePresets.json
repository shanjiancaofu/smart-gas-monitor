{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "arm-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "arm-debug-hw",
      "inherits": "arm-base",
      "displayName": "STM32F103 Debug / HW I2C",
      "binaryDir": "${sourceDir}/build/arm-debug-hw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "USE_SOFT_I2C": "OFF" }
    },
    {
      "name": "arm-debug-soft",
      "inherits": "arm-base",
      "displayName": "STM32F103 Debug / Soft I2C",
      "binaryDir": "${sourceDir}/build/arm-debug-soft",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "USE_SOFT_I2C": "ON" }
    },
    {
      "name": "arm-release-hw",
      "inherits": "arm-base",
      "displayName": "STM32F103 Release / HW I2C",
      "binaryDir": "${sourceDir}/build/arm-release-hw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "USE_SOFT_I2C": "OFF" }
    },
    {
      "name": "arm-release-soft",
      "inherits": "arm-base",
      "displayName": "STM32F103 Release / Soft I2C",
      "binaryDir": "${sourceDir}/build/arm-release-soft",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "USE_SOFT_I2C": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "arm-debug-hw", "configurePreset": "arm-debug-hw" },
    { "name": "arm-debug-soft", "configurePreset": "arm-debug-soft" },
    { "name": "arm-release-hw", "configurePreset": "arm-release-hw" },
    { "name": "arm-release-soft", "configurePreset": "arm-release-soft" }
  ]
}